# Copie para .env e preencha. O .env NUNCA vai para o GitHub.

# ---------- Landing page (vão para docs/config.js, ficam PÚBLICOS) ----------
# Links dos grupos, separados por vírgula. Quando um lotar, adicione o próximo e mude GRUPO_ATIVO.
GRUPOS_WHATSAPP=https://chat.whatsapp.com/SEU_CODIGO_AQUI
GRUPO_ATIVO=0
META_PIXEL_ID=
TIKTOK_PIXEL_ID=
MAKE_WEBHOOK_URL=

# ---------- Make API (leitura dos cliques; SECRETO) ----------
# Token: Make > perfil > API access. Zona: o prefixo da URL do seu Make (us1, us2, eu1, eu2).
MAKE_API_TOKEN=
MAKE_ZONA=us2
MAKE_DATA_STORE_ID=

# ---------- Meta Ads (SECRETO) ----------
# Token de Usuário do Sistema (Business Manager > Usuários do sistema) com permissão ads_read.
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_API_VERSION=v23.0

# ---------- TikTok Ads (opcional, só se rodar anúncios pagos no TikTok) ----------
TIKTOK_ACCESS_TOKEN=
TIKTOK_ADVERTISER_ID=

# ---------- Grupo ----------
LIMITE_GRUPO=1024
# Fração estimada de quem clica no botão e realmente entra no grupo (ajuste com o tempo).
TAXA_ENTRADA=0.7
